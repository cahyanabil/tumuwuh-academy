---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { programs } from '../data/programs';

const availablePrograms = programs.filter((program) => program.status === 'available');
---

<Layout title="Reservasi Program — Tumuwuh" description="Pilih program yang ingin kamu ikuti dan daftarkan dirimu untuk menjadi bagian dari perjalanan belajar bersama Tumuwuh.">
  <Navigation />

  <main class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#173F35]/60">Reservasi</p>
      <h1 class="mt-4 text-4xl font-extrabold text-[#173F35] sm:text-5xl">Mulai Perjalanan Belajarmu.</h1>
      <p class="mt-5 text-base leading-8 text-[#173F35]/75">
        Pilih program yang ingin kamu ikuti dan daftarkan dirimu untuk menjadi bagian dari perjalanan belajar bersama Tumuwuh.
      </p>
    </header>

    <section class="mt-12">
      <div class="mb-8 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold text-[#173F35]">Program yang tersedia</h2>
        <span class="rounded-full border border-[#173F35]/10 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-[#173F35]">
          {availablePrograms.length} pilihan
        </span>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        {availablePrograms.map((program) => (
          <article class="rounded-[28px] border border-[#173F35]/10 bg-white p-6 shadow-[0_18px_50px_rgba(12,42,34,0.04)]">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#173F35]/70">{program.category}</p>

            <h3 class="mt-4 text-2xl font-bold text-[#173F35]">{program.title}</h3>
            <p class="mt-4 text-sm leading-7 text-[#173F35]/75">{program.description}</p>

            <div class="mt-6 grid gap-3 text-sm text-[#173F35]">
              <div class="flex items-center justify-between gap-4 border-b border-[#173F35]/10 pb-3">
                <span class="text-[#173F35]/60">Durasi</span>
                <span class="font-medium">{program.duration}</span>
              </div>
              <div class="flex items-center justify-between gap-4 border-b border-[#173F35]/10 pb-3">
                <span class="text-[#173F35]/60">Jadwal</span>
                <span class="font-medium text-right">{program.schedule}</span>
              </div>
              <div class="flex items-center justify-between gap-4 border-b border-[#173F35]/10 pb-3">
                <span class="text-[#173F35]/60">Format</span>
                <span class="font-medium">{program.format}</span>
              </div>
            </div>

            <div class="mt-6">
              <p class="text-sm font-semibold uppercase tracking-[0.12em] text-[#173F35]/70">Tujuan belajar</p>
              <ul class="mt-3 space-y-2 text-sm leading-6 text-[#173F35]/75">
                {program.objectives.map((objective) => (
                  <li class="flex gap-2">
                    <span class="mt-1 h-2 w-2 rounded-full bg-[#D5E6A5]"></span>
                    <span>{objective}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={program.reservationUrl}
              target="_blank"
              rel="noreferrer"
              class="mt-8 inline-flex w-full items-center justify-center rounded-full border border-[#173F35] bg-[#173F35] px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#102D27]"
            >
              Reservasi Program
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
